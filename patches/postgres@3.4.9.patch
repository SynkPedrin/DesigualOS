diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..e3e5d1382f9284939d8d61780a238d0b0912940f 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -172,11 +172,19 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
         : (query = q, query.active = true)
 
       build(q)
-      return write(toBuffer(q))
+      // SEM PIPELINE (20/10/2026): o pooler do Supabase em modo transação
+      // devolveu respostas trocadas entre consultas enfileiradas na mesma
+      // conexão ("Invalid time value" lendo datas de outra consulta). E é o
+      // mesmo enfileiramento que acontecia na subida (12 "select 1" de uma vez
+      // no warm-up): resposta perdida = conexão esperando para sempre =
+      // requisições presas. Uma consulta por vez por conexão; PG_PIPELINE=1
+      // devolve o comportamento original.
+      const livre = write(toBuffer(q))
         && !q.describeFirst
         && !q.cursorFn
         && sent.length < max_pipeline
         && (!q.options.onexecute || q.options.onexecute(connection))
+      return livre && process.env.PG_PIPELINE === '1'
     } catch (error) {
       sent.length === 0 && write(Sync)
       errored(error)
@@ -223,6 +231,10 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     ])
   }
 
+  function valorSemTipoDoServidor(x) {
+    return x === null || typeof x === 'string' || typeof x === 'number' || typeof x === 'boolean' || typeof x === 'bigint' || x instanceof Date
+  }
+
   function build(q) {
     const parameters = []
         , types = []
@@ -237,7 +249,16 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     q.onlyDescribe && (delete statements[q.signature])
     q.parameters = q.parameters || parameters
     q.prepared = q.prepare && q.signature in statements
-    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared)
+    // DesigualOS (20/10/2026): sem prepare, o Describe custa uma ida a mais ao
+    // banco em TODA consulta com parâmetro (~125 ms até us-east-1). Ele só
+    // muda algo quando o valor é lista/objeto (o serializador depende do tipo
+    // do servidor). Com só texto/número/booleano/data/null, o servidor infere
+    // os tipos no Parse do mesmo jeito: vai direto. DESLIGADO por padrão:
+    // com o pooler do Supabase deu erro em produção (20/10/2026), com e sem
+    // pipeline. Só liga com PG_DESCRIBE_ATALHO=1, para testar com Postgres direto.
+    q.semDescribe = Boolean(parameters.length && !q.prepared && !q.onlyDescribe &&
+      !q.prepare && process.env.PG_DESCRIBE_ATALHO === '1' && q.parameters.every(valorSemTipoDoServidor))
+    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared && !q.semDescribe)
     q.statement = q.prepared
       ? statements[q.signature]
       : { string, types, name: q.prepare ? statementId + statementCount++ : '' }
