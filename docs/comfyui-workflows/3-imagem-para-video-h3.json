{
  "unet": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "MiniMax-H3-FL2VA-Q3_K_M.gguf"
    }
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "cpu"
    }
  },
  "vae_v": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "vae_a": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "img": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "desigual-ref-<uuid>-hero-frame.png"
    }
  },
  "i2v": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae_v",
        0
      ],
      "first_frame": [
        "img",
        0
      ],
      "prompt": "video curto de ondas do mar quebrando suavemente numa praia ao entardecer, luz dourada, movimento lento e calmo. Preserve the original scene exactly, do not add or remove any element, do not change the face or clothes, no new people. No zoom, no snap, no camera shake, no fast orbit, no dive. Cinematic film grain.",
      "width": 768,
      "height": 1344,
      "length": 124
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 123456789
    }
  },
  "sched": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "lora",
        0
      ],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1
    }
  },
  "ss": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "lora",
        0
      ],
      "conditioning": [
        "i2v",
        0
      ]
    }
  },
  "samp": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "ss",
        0
      ],
      "sigmas": [
        "sched",
        0
      ],
      "latent_image": [
        "i2v",
        1
      ]
    }
  },
  "dv": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "samp",
        0
      ],
      "vae": [
        "vae_v",
        0
      ]
    }
  },
  "da": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "samp",
        0
      ],
      "vae": [
        "vae_a",
        0
      ]
    }
  },
  "cv": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "dv",
        0
      ],
      "audio": [
        "da",
        0
      ],
      "fps": 24
    }
  },
  "sv": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "cv",
        0
      ],
      "filename_prefix": "video/desigual-os-studio",
      "format": "auto",
      "codec": "auto"
    }
  }
}