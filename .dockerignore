# Contexto de build do docker-compose.prod.yml (api/worker). Mesma ideia do
# .gitignore: nunca mandar node_modules/dist locais para dentro da imagem,
# eles são reconstruídos de novo no build multi-stage.
node_modules
**/node_modules
dist
**/dist
build
**/build
.next
**/.next
.turbo
**/.turbo
coverage
**/coverage

.env
.env.local
.env.*.local
!.env.example

*.log

.DS_Store
.git
.gitignore

# Projeto separado (landing page), não faz parte da imagem do Orchestrator.
LP - DESIGUAL OS/

# Documentação e vaults não precisam entrar no contexto de build, exceto
# Brain-Marketing (usado em runtime pela copy do Studio, ver Dockerfile.prod).
brain/
Brain-Marketing/STUDIO-BRAIN/
