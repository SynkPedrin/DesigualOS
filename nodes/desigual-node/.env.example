# Desigual Node Agent (roda em cada Mac Mini: Bento, Jarbas ou Suzy)
# Copie para .env e preencha para cada máquina. Nunca commitar o .env real.

PORT=4001

NODE_ID=NODE_BENTO_01
AGENT_NAME=bento
NODE_TYPE=mac_mini
# Host desta máquina na rede privada Tailscale (MagicDNS), nunca IP público.
PRIVATE_HOST=bento.tailnet.ts.net
VERSION=0.1.0
# Lista separada por vírgula.
CAPABILITIES=knowledge,reasoning,clickup,obsidian

# URL do Orchestrator central na rede privada.
ORCHESTRATOR_URL=http://localhost:3001
# Mesmo valor configurado em NODE_SECRET no .env do Orchestrator.
NODE_SECRET=

HEARTBEAT_INTERVAL_MS=10000

# OpenClaw roda na mesma máquina, chamado via CLI local (não HTTP).
OPENCLAW_BINARY=openclaw
# Id do agente configurado no OpenClaw (openclaw agents add). Se vazio, usa AGENT_NAME.
OPENCLAW_AGENT_ID=
OPENCLAW_TIMEOUT_SECONDS=600
OPENCLAW_GATEWAY_URL=http://localhost:18789

# Caminho local do vault Obsidian deste agente. Opcional; sem ele, sem contexto local.
OBSIDIAN_VAULT_PATH=
