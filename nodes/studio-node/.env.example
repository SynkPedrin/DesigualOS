# Studio Node Agent (roda no PC com a RTX 5090)
# Copie para .env e preencha. Nunca commitar o .env real.

NODE_ID=NODE_STUDIO_01
PRIVATE_HOST=studio.tailnet.ts.net
VERSION=0.1.0

# Mesmo Redis do Orchestrator (fila de jobs).
REDIS_URL=redis://localhost:6379

# Supabase (Storage), mesmo projeto do Orchestrator (ver ADR 0001).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=studio-assets

# GPU real (ComfyUI/runtime) ainda não está integrada; ver ADR 0005.
# Sem isso configurado, o worker gera um asset stub (SVG com o prompt),
# nunca finge que gerou uma imagem de verdade.
