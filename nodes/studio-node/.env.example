# Studio Node Agent (roda no PC com a RTX 4090)
# Copie para .env e preencha. Nunca commitar o .env real.

NODE_ID=NODE_STUDIO_01
PRIVATE_HOST=studio.tailnet.ts.net
VERSION=0.1.0

# Mesmo Redis do Orchestrator (fila de jobs).
REDIS_URL=redis://localhost:6379

# Supabase (Storage), mesmo projeto do Orchestrator (ver ADR 0001).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=studio-assets

# Geração real via ComfyUI/Flux já integrada (não é mais stub SVG; ADR 0005
# está desatualizada).
# URL do ComfyUI rodando na mesma máquina (Pinokio, porta padrão 8188). IP
# Tailscale direto, não o hostname MagicDNS: é o único caminho até agora
# confirmado alcançável a partir do Orchestrator.
COMFYUI_URL=http://100.107.198.50:8188
# FLUX.2 Dev: diffusion model, text encoder e VAE são três arquivos
# separados (sem checkpoint único); cada nome real é resolvido em runtime
# (resolveFluxModelNames), porque o arquivo instalado no ComfyUI pode
# variar. Pista de substring pra cada um.
COMFYUI_UNET_HINT=flux2
COMFYUI_CLIP_HINT=flux2
COMFYUI_VAE_HINT=flux2

# Caminho do Chrome usado pelo renderer de carrossel HTML (html-carousel/renderer.ts).
CHROME_PATH=

# Mesmo segredo compartilhado node<->Orchestrator (GET /metrics em :4100 e
# qualquer outro endpoint node-to-node exigem este token).
NODE_SECRET=

# Porta do endpoint GET /metrics lido pela sonda do Orchestrator.
METRICS_PORT=4100
