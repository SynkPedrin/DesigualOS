# Otto Node Agent (direção criativa; roda como Node Agent genérico, hoje
# local em dev, pode migrar para máquina dedicada mais tarde)
# Copie para .env e preencha. Nunca commitar o .env real.

# 4002: 4001 é a convenção do desigual-node; o Otto fica na porta seguinte
# para rodar na mesma máquina em dev sem conflito.
PORT=4002

NODE_ID=NODE_OTTO_01
# Fixo em 'otto': este node é especializado, não aceita outro AGENT_NAME.
AGENT_NAME=otto
NODE_TYPE=mac_mini
# Host desta máquina. Default é localhost (o node roda local em dev); ao
# migrar para uma máquina dedicada na Tailscale, aponte para o host real
# (MagicDNS), nunca IP público.
PRIVATE_HOST=http://localhost:4002
VERSION=0.1.0

# URL do Orchestrator central na rede privada.
ORCHESTRATOR_URL=http://localhost:3001
# Mesmo valor configurado em NODE_SECRET no .env do Orchestrator.
NODE_SECRET=

HEARTBEAT_INTERVAL_MS=10000

# --- LLM do Otto (packages/otto/src/llm/config.ts) ---
# Único provider suportado hoje.
OTTO_LLM_PROVIDER=ollama
# Endpoint do Ollama local (mesma máquina do otto-node).
OTTO_OLLAMA_URL=http://localhost:11434
OTTO_MODEL=mistral
# Caminho do vault de conhecimento criativo/estratégico (Brain-Marketing)
# que o otto-node lê localmente. Relativo ao cwd do processo de propósito
# (regra de ouro de portabilidade): o vault migra de máquina junto com o
# Otto, então nunca deve ser um path absoluto de uma máquina específica.
OTTO_BRAIN_PATH=./Brain-Marketing
# Geração de plano criativo é uma chamada longa (JSON grande); 120s casa com
# o timeout do passo de copy do Studio (packages/router/marketing-copy).
OTTO_LLM_TIMEOUT_MS=120000

# --- Ambiente (opcional; afeta só formatação de log) ---
# 'production' desliga o pino-pretty (log em JSON puro). Deixe vazio/dev em
# desenvolvimento local.
NODE_ENV=development
LOG_LEVEL=info
