{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "cpu"
    }
  },
  "vae_video": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "vae_audio": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "frame_load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "desigual-ref-<uuid>-hero-frame.png"
    }
  },
  "frame_fit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["frame_load", 0],
      "upscale_method": "lanczos",
      "width": 768,
      "height": 1344,
      "crop": "center"
    }
  },
  "i2v": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "first_frame": ["frame_fit", 0],
      "prompt": "Vertical 9:16 seascape at golden hour. The scene is a wide empty beach at sunset: small ocean waves roll in from the horizon and break softly on wet dark sand, with a low warm sun flaring across the water. The camera is a static locked-off tripod framing that holds identical for the entire clip. Shot 1, 0.0s to 2.5s: a wave rises at mid-frame, curls over and breaks into white foam, the foam sheet sliding forward across the sand toward the bottom of frame, then retreating and leaving a wet mirror sheen. Shot 2, 2.5s to 5.1s: the same framing holds as a thinner second wave glides in more slowly, its foam edge receding and revealing rippled sand that reflects the orange sky. Lighting stays warm and continuous throughout, golden rim light on every wave crest, soft haze on the horizon line, fine 35mm film grain. Audio: a steady low ocean swell with soft breaking foam and hissing retreat, faint distant gulls, gentle coastal wind. No music, no speech.",
      "width": 768,
      "height": 1344,
      "length": 124
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 123456789
    }
  },
  "scheduler": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["unet", 0],
      "scheduler": "simple",
      "steps": 25,
      "denoise": 1
    }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["unet", 0],
      "conditioning": ["i2v", 0]
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_select", 0],
      "sigmas": ["scheduler", 0],
      "latent_image": ["i2v", 1]
    }
  },
  "decode_video": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["vae_video", 0]
    }
  },
  "decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["vae_audio", 0]
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode_video", 0],
      "audio": ["decode_audio", 0],
      "fps": 24
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create_video", 0],
      "filename_prefix": "desigual-os-studio/%date:yyyy-MM-dd%/video",
      "format": "auto",
      "codec": "auto"
    }
  }
}
