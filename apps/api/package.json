    "@desigual-os/node-protocol": "workspace:*",
    "@desigual-os/orchestrator": "workspace:*",
    "@desigual-os/otto": "workspace:*",
    "@desigual-os/router": "workspace:*",
    "@desigual-os/tool-gateway": "workspace:*",
    "@desigual-os/types": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "dotenv": "^16.4.5",
