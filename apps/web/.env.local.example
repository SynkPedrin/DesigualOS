# Desigual OS: Web (apps/web)
# Copie para .env.local e ajuste. Nunca commitar o .env.local real.

# mock: todo dado vem do MSW (src/mocks). live: aponta para NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# Base URL do Orchestrator (apps/api). Só usada quando NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth: login e cadastro batem direto no Supabase no browser, sem tela de login
# própria nossa por trás. Independente de NEXT_PUBLIC_API_MODE (isso é só o Orchestrator).
# Publishable key é segura de expor no client (mesmo valor de SUPABASE_URL/
# SUPABASE_PUBLISHABLE_KEY na raiz do projeto, nunca a SUPABASE_SECRET_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
