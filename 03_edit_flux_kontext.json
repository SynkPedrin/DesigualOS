{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev-kontext_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux",
      "device": "cpu"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "src_load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "desigual-ref-<uuid>-referencia.png"
    }
  },
  "src_fit": {
    "class_type": "FluxKontextImageScale",
    "inputs": {
      "image": ["src_load", 0]
    }
  },
  "encode": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["src_fit", 0],
      "vae": ["vae", 0]
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["clip", 0],
      "text": "Repaint the car in deep metallic blue and replace the background with a snow-covered mountain road at dusk. Keep the car's exact shape, proportions, wheels, badges and body panel lines unchanged. Keep the original camera angle, focal length and framing identical. Match the new lighting to the scene: cold blue ambient light with soft snow reflections on the lower body panels."
    }
  },
  "reference": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": ["pos", 0],
      "latent": ["encode", 0]
    }
  },
  "guide": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["reference", 0],
      "guidance": 2.5
    }
  },
  "neg": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["pos", 0]
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["unet", 0],
      "positive": ["guide", 0],
      "negative": ["neg", 0],
      "latent_image": ["encode", 0],
      "seed": 123456789,
      "steps": 24,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["vae", 0]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["decode", 0],
      "filename_prefix": "desigual-os-studio/%date:yyyy-MM-dd%/kontext"
    }
  }
}
