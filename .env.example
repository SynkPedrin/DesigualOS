# Desigual OS: Orchestrator (apps/api e apps/worker)
# Copie para .env e preencha. Nunca commitar o .env real.

# --- Ambiente ---
NODE_ENV=development
PORT=3001
# Nível de log do Pino (fastify + createLogger). Default 'info' se ausente.
LOG_LEVEL=info

# --- Supabase (Postgres + Auth + Storage, ver ADR 0001 em docs/architecture/decisions) ---
SUPABASE_URL=https://dddchncdrgbhdirytdsp.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Connection string do Postgres (Project Settings > Database > Connection string),
# usada pelo Drizzle para migrations e queries. Diferente das chaves de API acima.
# Use a aba "Session pooler" (porta 5432, host aws-0-<regiao>.pooler.supabase.com),
# não "Direct connection": o host de conexão direta é IPv6-only por padrão no Supabase.
DATABASE_URL=
# Máximo de conexões do pool postgres-js por processo (packages/database/src/
# client.ts). Default 3 se ausente - o pooler do Supabase em session mode trava
# em pool_size:15 pro projeto inteiro, então api+worker+nodes juntos estouram
# fácil com o default de 10 do postgres-js. Ajuste por serviço em produção.
DATABASE_POOL_MAX=

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379
# Ajuste se a porta 6379 já estiver em uso por outro projeto na máquina.
REDIS_HOST_PORT=6379
# Só usada pelo docker-compose.prod.yml (VPS), para configurar a senha do
# Redis do próprio compose. Em produção, REDIS_URL acima precisa embutir a
# MESMA senha: redis://:<REDIS_PASSWORD>@redis:6379 (host "redis" é o nome
# do serviço no compose, não localhost). Em dev local, deixe REDIS_PASSWORD
# vazio: o docker-compose.yml de dev não usa essa variável, não tem senha.
REDIS_PASSWORD=

# --- Agentic V2 (worker) ---
# Liga o agent loop com estado (understand->context->plan->act->observe->
# evaluate->replan) no dispatch de chat, com checkpoint no Postgres
# (agent_execution_states) e outcome por execução (agent_outcomes).
# Valores: "false"/ausente = desligado; "true" = todos os agentes EXCETO o
# Jarbas (golden agent, nunca entra no loop); ou lista "bento,suzy,otto".
# Rollback seguro = voltar para false e reiniciar o worker.
AGENT_LOOP_V2=false

# --- Node Agent auth (Orchestrator <-> Mac Minis e RTX) ---
NODE_SECRET=

# --- Sonda de agentes (agent-probe, tela de Monitoramento) ---
# Todas as variáveis abaixo são OPCIONAIS. Cada uma já tem um default (IP
# real da tailnet) embutido em packages/orchestrator/src/agent-probe.ts;
# só preencha se o Orchestrator rodar fora da Tailscale padrão (ex: um
# túnel local em dev) e precisar de um caminho diferente até a máquina.
# Cada valor já inclui o protocolo (http:// ou https://), sem porta.
PROBE_BENTO_HOST=http://100.93.182.83
PROBE_SUZY_HOST=http://100.86.237.73
PROBE_JARBAS_HOST=http://100.118.12.97
PROBE_STUDIO_HOST=http://100.107.198.50
# PROBE_OTTO_HOST fica documentado na seção "Otto" mais abaixo: o default
# dele já inclui a porta (o otto-node roda local em dev), diferente dos
# quatro hosts acima.

# Override por SERVIÇO individual (também opcional, também com default):
# sobrescreve só a URL de UM serviço específico de um agente, sem trocar o
# host inteiro dele. Útil quando esse serviço está atrás de um caminho
# diferente do resto (ex: túnel numa porta local só para ele). Nome
# montado em tempo real por serviceUrl() como PROBE_<AGENTE>_<SERVICO>_URL,
# tudo maiúsculo e com hífen virando underscore (não hífen: "bento-qa" vira
# "BENTO_QA", não "BENTO-QA"). Exemplos reais de como cada um ficaria
# preenchido (com URL completa, incluindo o path do healthcheck):
# PROBE_BENTO_BENTO_QA_URL=http://localhost:18791/health
# PROBE_BENTO_SWARM_API_URL=http://localhost:18787/health
# PROBE_BENTO_MEMORY_API_URL=http://localhost:18790/memory/search
# PROBE_SUZY_SUSY_SERVICE_URL=http://localhost:13102/health
# PROBE_JARBAS_AGENTES_DESIGUAL_URL=http://localhost:23102/health
# PROBE_STUDIO_COMFYUI_URL=http://localhost:18188/system_stats
# PROBE_STUDIO_OLLAMA_URL=http://localhost:11434/api/tags
# PROBE_STUDIO_METRICS_URL=http://localhost:14100/metrics
# PROBE_OTTO_OTTO_NODE_URL=http://localhost:4002/health

# --- Auth de usuário (Supabase Auth + RBAC próprio, ver ADR 0001) ---
# E-mails que viram 'master' automaticamente no primeiro login.
MASTER_USER_EMAILS=
# URL do frontend, usada no link de convite de colaborador (POST /admin/invite).
FRONTEND_URL=http://localhost:3000

# --- Modelos de IA ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Integrações (Tool Gateway) ---
# As três abaixo não são lidas em nenhum código deste repositório hoje
# (confirmado por busca em todo o monorepo). O Tool Gateway de verdade usa
# CLICKUP_API_KEY (ClickUp) e o OAuth por colaborador mais abaixo; Meta Ads e
# Instagram ainda não têm integração real implementada. Mantidas aqui por
# rastreabilidade histórica (nomes previstos no prompt mestre do projeto);
# não é preciso preencher para subir o sistema em produção.
CLICKUP_TOKEN=
META_TOKEN=
INSTAGRAM_TOKEN=

# --- ClickUp (uma chave só, compartilhada; atribuição por e-mail, ver users.clickup_email) ---
# Gerar em ClickUp -> avatar -> Apps -> API Token (chave pessoal, começa com "pk_").
CLICKUP_API_KEY=
# Id do workspace/team do ClickUp (aparece na URL do ClickUp: app.clickup.com/<team_id>/...).
CLICKUP_TEAM_ID=

# --- E-mail transacional (convite de colaborador com a marca da Desigual) ---
# Gerar em resend.com -> API Keys.
RESEND_API_KEY=
# Sem domínio verificado em resend.com/domains, use "Nome <onboarding@resend.dev>".
RESEND_FROM_EMAIL=Desigual OS <onboarding@resend.dev>

# --- Enxame (swarm-api do Bento, tailnet only) ---
# Token emitido offline no Bento (scripts/issue-token.js), node_id=macbook.
# Nenhuma das duas é lida em código deste repositório hoje: o cliente do
# Orchestrator para o swarm-api nunca foi escrito (ver seção "Enxame client"
# em DESIGUAL_OS_CONTEXT_RECOVERY.md). O agent-probe já sonda swarm-api como
# serviço auxiliar do Bento via PROBE_BENTO_SWARM_API_URL (ver seção "Sonda
# de agentes" acima), que é o mecanismo ativo. Mantidas aqui por
# rastreabilidade histórica; não é preciso preencher para subir o sistema.
ENXAME_TOKEN=
ENXAME_SWARM_API_URL=http://100.93.182.83:8787

# --- Bento Q&A (pacote bento-qa, já em produção no Mac Mini do Bento) ---
# Mesmo token/endpoint que a Susy já usa no WhatsApp (bentoAsk.js). Token único
# e compartilhado entre todo consumidor legítimo, sem multi-token.
BENTO_QA_URL=http://100.93.182.83:8791
BENTO_QA_TOKEN=

# Memória do Bento (busca de contexto pra learning.ts/bento-mention.ts) e
# escrita real no vault dele - sem as duas, o auto-aprendizado fica 'pending'
# (degrada, não quebra, mas silenciosamente).
BENTO_MEMORY_API_URL=http://100.93.182.83:8790
BENTO_MEMORY_API_TOKEN=
BENTO_VAULT_WRITER_URL=
BENTO_VAULT_NAME=

# --- Agentes Desigual (POST /internal/ask do susy-service, porta 3102 nos
# Mac Minis do Jarbas e da Suzy; chat central + menções no ClickUp) ---
# Token único compartilhado, registrado em API_KEYS do serviço nas duas
# máquinas com permission "internal_ask".
AGENTES_ASK_TOKEN=
JARBAS_ASK_URL=http://100.118.12.97:3102
SUZY_ASK_URL=http://100.86.237.73:3102

# --- ClickUp webhook (rota pública única do Orchestrator) ---
# Gerado ao criar o webhook via API do ClickUp (POST /team/{team_id}/webhook).
CLICKUP_WEBHOOK_SECRET=

# --- ClickUp OAuth (conexão por colaborador) ---
# Criado em ClickUp > Settings > Apps > Create an App. O SECRET é backend-only:
# nunca prefixar com NEXT_PUBLIC_, nunca mandar pro browser/localStorage.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# Precisa bater exatamente com a Redirect URL cadastrada no app do ClickUp.
CLICKUP_REDIRECT_URI=http://localhost:3001/integrations/clickup/callback

# --- Cofre dos tokens de integração (AES-256-GCM) ---
# Opcional: 32 bytes em hex (openssl rand -hex 32). Sem isso, a chave é
# derivada do NODE_SECRET acima — trocar o NODE_SECRET obriga todo mundo a
# reconectar as integrações.
INTEGRATION_ENCRYPTION_KEY=

# --- Copy do Studio via Ollama (sem chave paga; decisão 2026-09-04) ---
# ministral-3:3b no Ollama do PC do Studio.
# Gateway, não a placa: a API é outro processo e falar direto com a RTX
# punha um concorrente invisível pro controle de admissão.
COPY_OLLAMA_URL=http://127.0.0.1:11500
COPY_OLLAMA_MODEL=ministral-3:3b

# --- Otto (direção criativa; otto-node, porta 4002) ---
# Host usado pela sonda do Orchestrator (agent-probe). Em dev o otto-node
# roda local; o default já inclui a porta.
PROBE_OTTO_HOST=http://localhost:4002
# LLM do otto-node: provider e endpoint do Ollama local + modelo de
# raciocínio criativo.
OTTO_LLM_PROVIDER=ollama
OTTO_OLLAMA_URL=http://localhost:11434
OTTO_MODEL=mistral
# Caminho do vault de conhecimento criativo/estratégico (Brain-Marketing) que o
# otto-node lê localmente. Relativo ao cwd do node; quando o Otto migrar para a
# máquina dedicada, basta apontar para onde a pasta Brain-Marketing estiver.
OTTO_BRAIN_PATH=./Brain-Marketing

# --- Studio > Canva: banco de imagens (Pexels/Unsplash/Pixabay) ---
# Nunca lidas no browser - só o Orchestrator chama essas APIs; o frontend
# fala só com nossos próprios endpoints /studio/canvas-images/*.
# Gerar em pexels.com -> API -> Your API Key.
PEXELS_API_KEY=
# Gerar em unsplash.com/oauth/applications -> criar app -> Keys.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
# Gerar em pixabay.com/api/docs -> Your API Key.
PIXABAY_API_KEY=

# --- Alerta operacional (opcional) ---
# Webhook de entrada do Slack (Slack > seu workspace > Apps > Incoming
# Webhooks). Sem isso, sendOpsAlert (packages/orchestrator/src/alerts.ts)
# vira no-op silencioso - o gancho já está chamado nos pontos certos (agente
# caiu, job esgotou tentativas), só falta colar a URL do canal de operação.
# Até 08/09/2026 não existia alerta automático nenhum, só a tela de
# Monitoramento manual. Ver docs/runbook.md.
ALERT_SLACK_WEBHOOK_URL=

# --- Frontend (apps/web / Vercel) ---
# Vão no ambiente da Vercel (ou em apps/web/.env.local em dev), NÃO no .env
# do Orchestrator - o prefixo NEXT_PUBLIC_ embute o valor no bundle do
# browser, então NUNCA colocar segredo aqui.
# URL do projeto Supabase (a mesma de SUPABASE_URL acima).
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
# Chave pública ("publishable") do Supabase - segura pro browser por design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL base do Orchestrator que o browser chama (ex: https://api.exemplo.com
# ou http://localhost:3001 em dev).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Sem NEXT_PUBLIC_API_MODE=live o app roda em modo mock (MSW): os dados vêm
# de handlers falsos no browser, não do Orchestrator. Preencher com "live"
# em produção e em qualquer dev que precise bater na API de verdade.
NEXT_PUBLIC_API_MODE=

# --- Controle de admissão da GPU (porta única da RTX 4090) ---
# Limite GLOBAL, não por agente: dois limites de 1 ainda são 2 na placa.
# Começa em 1; subir só com medição de carga real (ver docs).
MAX_GPU_STRONG_CONCURRENCY=1
# Quantos podem ESPERAR além do que está gerando. Acima disso, recusa rápida —
# fila infinita transforma saturação em timeout de todo mundo.
GPU_QUEUE_MAX_DEPTH=6
GPU_QUEUE_MAX_WAIT_MS=45000
# O gateway escuta aqui (worker). NÃO é publicado pelo Funnel: só tailnet.
GPU_GATEWAY_PORT=11500
GPU_UPSTREAM_URL=http://100.107.198.50:11434
# Acima do maior timeout de cliente (Otto: 300s). Um teto MENOR cortaria
# quem ainda estava esperando — e agora que a desistencia do cliente ja
# devolve a vaga, este teto e so rede de seguranca.
GPU_UPSTREAM_TIMEOUT_MS=330000
