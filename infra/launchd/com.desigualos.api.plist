<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Supervisor da API do orquestrador.

  A API é o processo que continua de pé quando o worker morre — e é justamente essa assimetria
  que faz o sistema conseguir DETECTAR a morte do worker (ver apps/api/src/health/worker-watchdog.ts).
  Se ela também cair sem supervisor, o sistema perde ao mesmo tempo a porta de entrada e o único
  vigia. Por isso ela tem supervisor próprio, e não compartilha processo com nada.

  Ela também roda sem `watch`: em 10/09/2026 o watcher do tsx derrubou API e worker no meio de
  uma bateria de testes, e o que o usuário viu foi erro genérico no chat.

  DECISÕES:
  - KeepAlive.SuccessfulExit=false + Crashed=true: volta em qualquer saída que não seja parada
    limpa. Saída 0 (SIGTERM tratado em server.ts) não reinicia, pra dar pra parar de propósito.
  - ExitTimeOut=90: o shutdown de server.ts fecha o Fastify esperando as requisições em voo;
    matar antes disso corta resposta na cara de quem está usando.
  - ProcessType=Background: sem throttle de CPU do macOS quando a máquina está ociosa.

  INSTALAR:
    cp infra/launchd/com.desigualos.api.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.desigualos.api.plist
    launchctl kickstart -k gui/$(id -u)/com.desigualos.api
  PARAR:
    launchctl bootout gui/$(id -u)/com.desigualos.api
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.desigualos.api</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/pedro/DesigualOS/apps/api/node_modules/.bin/tsx</string>
    <string>src/server.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/pedro/DesigualOS/apps/api</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>/Users/pedro/.local/toolchain/node/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ExitTimeOut</key>
  <integer>90</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/pedro/Library/Logs/desigualos-api.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pedro/Library/Logs/desigualos-api.log</string>
</dict>
</plist>
