{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "fp8_e4m3fn_fast"
    }
  },
  "clip": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux",
      "device": "cpu"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "src_load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "desigual-ref-<uuid>-upscale-source.png"
    }
  },
  "upscale_model": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x-ClearRealityV1.pth"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["clip", 0],
      "text": "High resolution photographic detail, natural micro-texture, visible surface grain, sharp edge definition without haloing, realistic material rendering, 35mm film texture."
    }
  },
  "neg": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["pos", 0]
    }
  },
  "guide": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": ["pos", 0],
      "guidance": 2.0
    }
  },
  "refine": {
    "class_type": "UltimateSDUpscale",
    "inputs": {
      "image": ["src_load", 0],
      "model": ["unet", 0],
      "positive": ["guide", 0],
      "negative": ["neg", 0],
      "vae": ["vae", 0],
      "upscale_model": ["upscale_model", 0],
      "upscale_by": 2.0,
      "seed": 123456789,
      "steps": 14,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "beta",
      "denoise": 0.22,
      "mode_type": "Linear",
      "tile_width": 1024,
      "tile_height": 1024,
      "mask_blur": 12,
      "tile_padding": 32,
      "seam_fix_mode": "Half Tile",
      "seam_fix_denoise": 1,
      "seam_fix_width": 64,
      "seam_fix_mask_blur": 8,
      "seam_fix_padding": 16,
      "force_uniform_tiles": true,
      "tiled_decode": false
    }
  },
  "resize": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["refine", 0],
      "upscale_method": "lanczos",
      "width": 1080,
      "height": 1350,
      "crop": "center"
    }
  },
  "sharpen": {
    "class_type": "ImageSharpen",
    "inputs": {
      "image": ["resize", 0],
      "sharpen_radius": 1,
      "sigma": 0.8,
      "alpha": 0.22
    }
  },
  "grain": {
    "class_type": "ImageAddNoise",
    "inputs": {
      "image": ["sharpen", 0],
      "seed": 123456789,
      "strength": 0.025
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["grain", 0],
      "filename_prefix": "desigual-os-studio/%date:yyyy-MM-dd%/final"
    }
  }
}
